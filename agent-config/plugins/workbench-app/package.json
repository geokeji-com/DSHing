{
  "name": "dsh-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "云上生文 Agent 工作台：按原型 v2 把 DSH web 界面做成产品界面（装配台 / 会话渲染 / 右栏审核）。host 半负责浏览器做不到的事（走 knowledge MCP 拿客户），client 半是全部界面。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
